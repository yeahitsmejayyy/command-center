#!/usr/bin/env bash
# The single entry point into command-center.
#
# ADR-001 chose to ship source rather than a compiled binary, so exactly one
# thing must be resolved at runtime: Bun. All of that lives here, in one file
# you can read top to bottom — which matters, because plugin hooks execute
# unsandboxed with the user's credentials and SECURITY.md has to make an
# auditable claim about what runs.
#
# Two callers with opposite needs:
#
#   `cmc hook <event>`  — Claude Code, on a session lifecycle event.
#                         MUST exit 0 always: a failing hook is a broken editor.
#                         MUST keep stdout pure JSON: Claude Code parses it.
#
#   `cmc <anything>`    — a person, or a slash command, at a terminal.
#                         MUST report failure honestly with a real exit code.
#
# That divergence is why the mode is detected here rather than pushed down.
set -uo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

HOOK_MODE=0
[ "${1:-}" = "hook" ] && HOOK_MODE=1

BUN_INSTALL_HINT='curl -fsSL https://bun.sh/install | bash'

find_bun() {
  # PATH first: whatever the user's own shell would pick.
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi

  # A hook does not run in a login shell, so a Bun installed by its own
  # installer is frequently missing from PATH here even though `bun` works
  # fine in the user's terminal. Check the standard locations before failing.
  local candidate
  for candidate in \
    "${BUN_INSTALL:-$HOME/.bun}/bin/bun" \
    "$HOME/.bun/bin/bun" \
    "/opt/homebrew/bin/bun" \
    "/usr/local/bin/bun" \
    "/usr/bin/bun"; do
    [ -x "$candidate" ] && { echo "$candidate"; return 0; }
  done

  return 1
}

# JSON string escaping. The messages below are static today, but hand-built
# JSON that breaks the first time a path contains a quote is a trap worth
# closing now rather than debugging later.
json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

# How a failure is reported depends entirely on who is listening.
#   hook  → say it in the session (stdout JSON) and to stderr, then exit 0
#   human → say it plainly on stderr, and exit non-zero
die() {
  local message=$1 exit_code=${2:-127}

  echo "$message" >&2

  if [ "$HOOK_MODE" -eq 1 ]; then
    # Only SessionStart can inject context; every other event has no channel
    # into the session, so stderr is the whole story there.
    if [ "${HOOK_EVENT:-}" = "session-start" ]; then
      printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' \
        "$(json_escape "$message")"
    fi
    exit 0
  fi

  exit "$exit_code"
}

if [ "$HOOK_MODE" -eq 1 ]; then
  HOOK_EVENT="${2:-}"
  ENTRY="${PLUGIN_ROOT}/src/surfaces/hook/main.ts"
  shift # drop "hook"; the rest is the event and its flags
else
  ENTRY="${PLUGIN_ROOT}/src/surfaces/cli/main.ts"
fi

BUN="$(find_bun)" || die \
  "command-center needs Bun, which is not installed (or is not on PATH here). Install it with: ${BUN_INSTALL_HINT} — then start a new session."

[ -f "$ENTRY" ] || die \
  "command-center is installed but its code is missing at ${ENTRY}. The install looks incomplete — reinstalling the plugin should fix it."

exec "$BUN" run "$ENTRY" "$@"
