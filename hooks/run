#!/usr/bin/env bash
# The runtime resolver — the single place install complexity is allowed to live.
#
# ADR-001 chose to ship source rather than a compiled binary, so the one thing
# that must be resolved at runtime is Bun itself. Everything about "how does
# this actually execute" belongs in this file and nowhere else.
#
# Two rules, both about not breaking someone's editor:
#   1. Always exit 0. A hook that fails is a broken session; a hook that can't
#      run should be quiet and explain itself, not fatal.
#   2. Never write anything but the hook's own JSON to stdout — Claude Code
#      parses it. Diagnostics go to stderr.
set -uo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
ENTRY="${PLUGIN_ROOT}/src/surfaces/hook/main.ts"

find_bun() {
  # PATH first: whatever the user's shell would use.
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi

  # A hook's environment is not a login shell, so a Bun installed by its own
  # installer is frequently absent from PATH here even though `bun` works fine
  # in the user's terminal. Check the standard locations before giving up.
  local candidate
  for candidate in \
    "${BUN_INSTALL:-$HOME/.bun}/bin/bun" \
    "$HOME/.bun/bin/bun" \
    "/opt/homebrew/bin/bun" \
    "/usr/local/bin/bun" \
    "/usr/bin/bun"; do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done

  return 1
}

# Tell the user through the session itself. stderr alone would be invisible.
emit_context() {
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$1"
}

BUN="$(find_bun)" || {
  echo "command-center: Bun was not found on PATH." >&2
  emit_context "command-center needs Bun, which is not installed (or not on PATH for hooks). Tell the user to install it with: curl -fsSL https://bun.sh/install | bash — then restart this session. The task board is inactive until then."
  exit 0
}

if [ ! -f "$ENTRY" ]; then
  echo "command-center: entry point missing at ${ENTRY}" >&2
  emit_context "command-center is installed but its code is missing at ${ENTRY}. The install looks incomplete — reinstalling the plugin should fix it."
  exit 0
fi

exec "$BUN" run "$ENTRY" "$@"
